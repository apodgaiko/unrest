{
  "bounded_sequence": [
    "persist_reason_and_revoke_new_authority",
    "request_cooperative_stop",
    "drain_until_lease_bound",
    "inventory_settled_partial_unknown_state",
    "retain_permitted_partial_artifacts_and_effects",
    "terminate_or_quarantine_within_authority",
    "idempotent_owned_resource_cleanup",
    "receipt_or_durable_attention"
  ],
  "branch_rule": "A released terminal requires cleanup succeeded and effect state absent, settled, compensated, or transferred. Transfer requires an atomic durable receipt naming external_effect_recovery_authority. Partial, unknown, or unsettled effect state ends only in quarantined or unsettled_effect_attention.",
  "closed_role_catalog_ref": "../integration/cross-family-authority.v1.json#/role_catalog",
  "closed_schema": {
    "cleanup": {
      "attempt_id": "nonempty_ascii_id",
      "evidence_retained_before_root_removal": "boolean",
      "result": "failed|not_run|succeeded",
      "root_removed": "boolean"
    },
    "drain": {
      "bound_seconds": "safe_positive_integer",
      "claimant_count": "integer_0_or_1",
      "completed_within_bound": "boolean",
      "prior_owner_absence_proven": "boolean",
      "result": "nonempty_ascii_id"
    },
    "effect": {
      "recovery_owner_role_id": "closed_role_id_or_absent",
      "state": "absent|settled|compensated|partial|unknown|unsettled|transferred",
      "transfer_authority_role_id": "closed_role_id_or_absent",
      "transfer_receipt_id": "nonempty_ascii_id_or_absent"
    },
    "replay": {
      "first_terminal_disposition": "terminal_disposition",
      "identical_result": "literal_true",
      "second_terminal_disposition": "terminal_disposition"
    },
    "scenario": {
      "branch_class": "cancel|cleanup_failure|cleanup_success|crash|effect_attention|orphan|quarantine|restart|transfer",
      "cleanup": "cleanup",
      "drain": "closed_drain_record",
      "effect": "effect",
      "evidence": "sorted_unique_nonempty_ascii_id_array",
      "id": "nonempty_ascii_id",
      "owner_role_id": "closed_role_id",
      "replay": "replay",
      "terminal_disposition": "terminal_disposition"
    },
    "unknown_fields": "reject"
  },
  "negative_cases": [
    {
      "baseline_scenario_id": "WS-RECOVERY-CLEANUP-SUCCESS",
