        "owner": {
          "enum": [
            "campaign_authority",
            "campaign_budget_authority",
            "campaign_stop_authority",
            "compatibility_probe_validator",
            "external_effect_authority",
            "external_effect_recovery_authority",
            "holdout_custodian",
            "identity_encoding_authority",
