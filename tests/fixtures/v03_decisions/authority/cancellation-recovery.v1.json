  "current_v02_limitations": [
    "abort_project_does_not_prove_cooperative_live_worker_stop",
    "task_graph_cancel_only_rewrites_pending_or_failed_nodes",
    "terminal_review_teardown_is_not_live_worker_cancellation"
  ],
  "negative_cases": [
    {
      "expected_failure_reason": "graph_cancellation_does_not_stop_live_worker",
      "id": "CANCEL-BYPASS-GRAPH-AS-LIVE-STOP",
      "mutation": "replace bounded action with pending-node graph cancellation",
      "route_id": "running_work_in_flight",
      "valid": false
    },
    {
      "expected_failure_reason": "route_requires_exactly_one_owner",
      "id": "CANCEL-BYPASS-MISSING-OWNER",
      "mutation": "remove owner",
      "route_id": "workspace_returned",
      "valid": false
    },
    {
      "expected_failure_reason": "compound_owner_forbidden",
      "id": "CANCEL-BYPASS-MULTIPLE-OWNERS",
      "mutation": "replace owner string with two-owner array",
      "route_id": "promotion_partial_apply",
      "valid": false
    },
    {
      "expected_failure_reason": "retry_must_preserve_prior_generation",
      "id": "CANCEL-BYPASS-RETRY-REWRITES-HISTORY",
      "mutation": "reuse generation and overwrite prior outcome",
      "route_id": "external_effect_retry",
      "valid": false
    },
    {
      "expected_failure_reason": "terminal_review_teardown_does_not_stop_live_worker",
      "id": "CANCEL-BYPASS-TEARDOWN-AS-STOP",
      "mutation": "replace bounded drain with terminal review teardown",
      "route_id": "running_work_timeout",
      "valid": false
    },
    {
      "expected_failure_reason": "unknown_effect_cannot_be_success",
      "id": "CANCEL-BYPASS-UNKNOWN-AS-CLEAN",
      "mutation": "replace explicit uncertainty with settled success",
      "route_id": "rollback_unknown_effect",
      "valid": false
    },
    {
      "expected_failure_reason": "workspace_deletion_does_not_reverse_effect",
      "id": "CANCEL-BYPASS-WORKTREE-DELETE-AS-REVERSAL",
      "mutation": "replace effect recovery with workspace deletion",
      "route_id": "rollback_partial_effect",
      "valid": false
    }
  ],
