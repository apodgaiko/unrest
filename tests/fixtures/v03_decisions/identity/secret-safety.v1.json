{
  "allowlist": [
    {
      "category": "artifact_provenance",
      "permitted_fields": [
        "artifact_digest",
        "artifact_id",
        "media_type",
        "size"
      ]
    },
    {
      "category": "public_configuration",
      "permitted_fields": [
        "algorithm_id",
        "environment_manifest_digest",
        "model_id",
        "policy_digest",
        "provider_family",
        "public_endpoint_id",
        "route_profile_digest",
        "schema_id"
      ]
    },
    {
      "category": "public_secret_set_version",
      "permitted_fields": [
        "issuer_namespace",
        "secret_set_name",
        "secret_set_version_id"
      ]
    }
  ],
  "construction_rule": "construct from the allowlist; never capture broadly and redact later",
  "leak_cases": [
