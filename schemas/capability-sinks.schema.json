{
  "$defs": {
    "CapabilitySink": {
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "title": "Enforcement",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "title": "Implementation",
          "type": "string"
        },
        "inventory": {
          "const": "SensitiveValueInventory",
          "title": "Inventory",
          "type": "string"
        },
        "sink_class": {
          "enum": [
            "runtime",
            "protocol",
            "diagnostic",
            "artifact",
            "package"
          ],
          "title": "Sink Class",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sink_class",
        "implementation",
        "enforcement",
        "inventory"
      ],
      "title": "CapabilitySink",
      "type": "object"
    },
    "CapabilitySinkOmission": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "implementation",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://unrest.dev/schemas/capability-sinks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "const": "unrest-capability-sinks",
      "title": "Catalog Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "reachable_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reachable Source Sha256",
      "type": "string"
    },
    "omissions": {
      "items": {
        "$ref": "#/$defs/CapabilitySinkOmission"
      },
      "type": "array"
    },
    "sinks": {
      "items": {
        "$ref": "#/$defs/CapabilitySink"
      },
      "title": "Sinks",
      "type": "array"
    }
  },
  "required": [
    "catalog_id",
    "schema_version",
    "reachable_source_sha256",
    "omissions",
    "sinks"
  ],
  "title": "CapabilitySinkCatalog",
  "type": "object"
}
