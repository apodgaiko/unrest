{
  "$defs": {
    "AccountableRole": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "team"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "AccountableRole",
      "type": "object"
    },
    "EvaluationRequirement": {
      "additionalProperties": false,
      "properties": {
        "selection": {
          "const": "strongest-applicable",
          "title": "Selection",
          "type": "string"
        },
        "tiers": {
          "items": {
            "enum": [
              "concurrency",
              "full-repository",
              "installed-wheel",
              "live-provider",
              "private-holdout",
              "real-cli-mcp-acp",
              "security"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "selection",
        "tiers"
      ],
      "title": "EvaluationRequirement",
      "type": "object"
    },
    "ProtectedSelector": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "component",
            "path",
            "path-prefix"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ProtectedSelector",
      "type": "object"
    },
    "ProtectedSurface": {
      "additionalProperties": false,
      "properties": {
        "evaluation": {
          "$ref": "#/$defs/EvaluationRequirement"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "reviewer_roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewer Roles",
          "type": "array"
        },
        "rollback_plan_required": {
          "const": true,
          "title": "Rollback Plan Required",
          "type": "boolean"
        },
        "selectors": {
          "items": {
            "$ref": "#/$defs/ProtectedSelector"
          },
          "minItems": 1,
          "title": "Selectors",
          "type": "array"
        }
      },
      "required": [
        "id",
        "selectors",
        "reviewer_roles",
        "rollback_plan_required",
        "evaluation"
      ],
      "title": "ProtectedSurface",
      "type": "object"
    },
    "SelfProtectionControl": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "pattern": "^[a-z][a-z0-9-]+$",
          "title": "Category Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ProtectedSelector"
        }
      },
      "required": [
        "id",
        "category_id",
        "selector"
      ],
      "title": "SelfProtectionControl",
      "type": "object"
    }
  },
  "$id": "https://unrest.dev/schemas/protected-surfaces-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_roles": {
      "items": {
        "$ref": "#/$defs/AccountableRole"
      },
      "minItems": 1,
      "title": "Accountable Roles",
      "type": "array"
    },
    "forbidden_approver_kinds": {
      "items": {
        "enum": [
          "agent",
          "provider"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Approver Kinds",
      "type": "array"
    },
    "policy_id": {
      "const": "GOV-PROTECTED-SURFACES-001",
      "title": "Policy Id",
      "type": "string"
    },
    "protected_surfaces": {
      "items": {
        "$ref": "#/$defs/ProtectedSurface"
      },
      "minItems": 1,
      "title": "Protected Surfaces",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "self_protection": {
      "items": {
        "$ref": "#/$defs/SelfProtectionControl"
      },
      "minItems": 1,
      "title": "Self Protection",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "accountable_roles",
    "forbidden_approver_kinds",
    "protected_surfaces",
    "self_protection"
  ],
  "title": "ProtectedSurfacePolicy",
  "type": "object"
}
