{
  "$defs": {
    "ApprovalCapability": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "enum": [
            "deny",
            "allow_once"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "tool_kinds": {
          "items": {
            "enum": [
              "read",
              "edit",
              "delete",
              "move",
              "search",
              "execute",
              "think",
              "fetch",
              "other"
            ],
            "type": "string"
          },
          "title": "Tool Kinds",
          "type": "array"
        }
      },
      "required": [
        "behavior",
        "tool_kinds"
      ],
      "title": "ApprovalCapability",
      "type": "object"
    },
    "CapabilityProfiles": {
      "additionalProperties": false,
      "properties": {
        "safe": {
          "$ref": "#/$defs/RoleCapabilities"
        },
        "unsafe-development-unrestricted": {
          "$ref": "#/$defs/RoleCapabilities"
        }
      },
      "required": [
        "safe",
        "unsafe-development-unrestricted"
      ],
      "title": "CapabilityProfiles",
      "type": "object"
    },
    "EnvironmentCapability": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "items": {
            "type": "string"
          },
          "title": "Credentials",
          "type": "array"
        },
        "forward": {
          "items": {
            "type": "string"
          },
          "title": "Forward",
          "type": "array"
        },
        "inherit_all": {
          "default": false,
          "title": "Inherit All",
          "type": "boolean"
        },
        "internal": {
          "items": {
            "type": "string"
          },
          "title": "Internal",
          "type": "array"
        },
        "terminal_injection": {
          "items": {
            "type": "string"
          },
          "title": "Terminal Injection",
          "type": "array"
        }
      },
      "required": [
        "forward",
        "credentials",
        "terminal_injection",
        "internal"
      ],
      "title": "EnvironmentCapability",
      "type": "object"
    },
    "NetworkCapability": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "NetworkCapability",
      "type": "object"
    },
    "ProcessCapability": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "commands"
      ],
      "title": "ProcessCapability",
      "type": "object"
    },
    "RoleCapabilities": {
      "additionalProperties": false,
      "properties": {
        "orchestrator": {
          "$ref": "#/$defs/RoleCapability"
        },
        "terminal_reviewer": {
          "$ref": "#/$defs/RoleCapability"
        },
        "validator": {
          "$ref": "#/$defs/RoleCapability"
        },
        "worker": {
          "$ref": "#/$defs/RoleCapability"
        }
      },
      "required": [
        "orchestrator",
        "worker",
        "validator",
        "terminal_reviewer"
      ],
      "title": "RoleCapabilities",
      "type": "object"
    },
    "RoleCapability": {
      "additionalProperties": false,
      "properties": {
        "approvals": {
          "$ref": "#/$defs/ApprovalCapability"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentCapability"
        },
        "filesystem": {
          "items": {
            "$ref": "#/$defs/RootCapability"
          },
          "title": "Filesystem",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/NetworkCapability"
        },
        "process": {
          "$ref": "#/$defs/ProcessCapability"
        }
      },
      "required": [
        "filesystem",
        "process",
        "network",
        "environment",
        "approvals"
      ],
      "title": "RoleCapability",
      "type": "object"
    },
    "RootCapability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "workspace",
            "project_record",
            "deliverable_roots",
            "host"
          ],
          "title": "Name",
          "type": "string"
        },
        "read": {
          "title": "Read",
          "type": "boolean"
        },
        "write": {
          "title": "Write",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "read",
        "write"
      ],
      "title": "RootCapability",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "const": "unrest-role-capabilities",
      "title": "Policy Id",
      "type": "string"
    },
    "profiles": {
      "$ref": "#/$defs/CapabilityProfiles"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "policy_id",
    "schema_version",
    "profiles"
  ],
  "title": "CapabilityPolicy",
  "type": "object"
}
