        {"additionalProperties": false, "properties": {"mission_id": {"type": "string"}, "state": {"const": "mission_running"}}, "required": ["state", "mission_id"], "type": "object"},
        {"additionalProperties": false, "properties": {"items": {"default": [], "items": {"$ref": "#/definitions/attention_item"}, "type": "array"}, "state": {"const": "attention_needed"}}, "required": ["state"], "type": "object"},
        {"additionalProperties": false, "properties": {"state": {"const": "done"}}, "required": ["state"], "type": "object"},
        {"additionalProperties": false, "properties": {"reason": {"type": "string"}, "state": {"const": "failed"}}, "required": ["state", "reason"], "type": "object"},
        {"additionalProperties": false, "properties": {"reason": {"type": "string"}, "state": {"const": "aborted"}}, "required": ["state", "reason"], "type": "object"}
      ]
