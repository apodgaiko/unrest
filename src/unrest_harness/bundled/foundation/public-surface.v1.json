      "properties": {
        "attempt_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
        "blocker_code": {"enum": ["dependency_unavailable", "scope_ambiguous", "scope_violation", "integrity_refusal", "authority_required", "delivery_blocked", null]},
        "checkpoint_requests": {"maximum": 2, "minimum": 0, "type": "integer"},
        "checkpoint_sequence": {"minimum": 0, "type": "integer"},
        "completed_target_ids": {"items": {"pattern": "^[A-Z][A-Z0-9-]+$", "type": "string"}, "type": "array", "uniqueItems": true},
        "elapsed_nanoseconds": {"minimum": 0, "type": "integer"},
