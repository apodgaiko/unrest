      "additionalProperties": false,
      "properties": {"campaign_id": {"minLength": 1, "type": "string"}, "candidate_id": {"minLength": 1, "type": "string"}, "human_grant_id": {"minLength": 1, "type": "string"}, "idempotency_key": {"minLength": 1, "type": "string"}},
