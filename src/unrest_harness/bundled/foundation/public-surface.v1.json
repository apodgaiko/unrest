        {"if": {"properties": {"operation": {"const": "end_mission"}}}, "then": {"properties": {"arguments": {"$ref": "#/definitions/end_mission_args"}}}},
        {"if": {"properties": {"operation": {"const": "start_project"}}}, "then": {"properties": {"arguments": {"$ref": "#/definitions/start_project_args"}}}},
