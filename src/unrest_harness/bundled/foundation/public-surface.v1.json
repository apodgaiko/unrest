      "required": ["attempt_id", "blocker_code", "checkpoint_requests", "checkpoint_sequence", "completed_target_ids", "elapsed_nanoseconds", "last_effect_sequence", "mission_id", "node_id", "phase", "project_id", "remaining_target_ids", "role", "scope_status", "supervision_status", "terminal_review_id"],
      "type": "object"
