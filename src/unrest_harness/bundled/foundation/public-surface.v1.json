      "properties": {"accepted_point_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, "budget": {"$ref": "#/definitions/budget"}, "evaluator_id": {"minLength": 1, "type": "string"}, "idempotency_key": {"minLength": 1, "type": "string"}, "project_id": {"minLength": 1, "type": "string"}, "reviewer_id": {"minLength": 1, "type": "string"}, "seed": {"type": "integer"}, "workload_id": {"minLength": 1, "type": "string"}},
      "required": ["project_id", "accepted_point_digest", "workload_id", "evaluator_id", "reviewer_id", "budget", "seed", "idempotency_key"],
