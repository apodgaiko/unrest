        "inquiry_id": {"type": "string"},
        "receipt_id": {"type": ["string", "null"]},
        "state": {"enum": ["answered", "budget_exhausted", "cancelled", "exploring", "failed", "open", "paused", "synthesizing"]}
      },
      "required": ["answer", "inquiry_id", "state", "branch_outcomes", "diagnostics", "receipt_id"],
      "type": "object"
