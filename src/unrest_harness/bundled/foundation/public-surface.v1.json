      "allOf": [{"if": {"properties": {"action": {"const": "nudge"}}}, "then": {"properties": {"body": {"minLength": 1, "type": "string"}}, "required": ["body"]}, "else": {"properties": {"body": {"type": "null"}}}}],
      "oneOf": [{"properties": {"node_id": {"type": "string"}, "terminal_review_id": {"type": "null"}}}, {"properties": {"node_id": {"type": "null"}, "terminal_review_id": {"type": "string"}}}],
      "properties": {"action": {"enum": ["continue", "nudge", "stop_for_attention"]}, "actor": {"const": "orchestrator"}, "attempt_id": {"minLength": 1, "type": "string"}, "body": {"default": null}, "checkpoint_sequence": {"minimum": 0, "type": "integer"}, "mission_id": {"minLength": 1, "type": "string"}, "node_id": {"type": ["string", "null"]}, "project_id": {"minLength": 1, "type": "string"}, "terminal_review_id": {"type": ["string", "null"]}},
      "required": ["project_id", "mission_id", "node_id", "terminal_review_id", "attempt_id", "checkpoint_sequence", "action", "actor"],
