      "required": ["inquiry_id", "reason", "idempotency_key"],
      "type": "object"
    },
    "inquiry_summary": {
      "additionalProperties": false,
      "properties": {
        "answer": {"type": ["string", "null"]},
        "branch_outcomes": {
          "additionalProperties": false,
          "properties": {
            "analogy": {"enum": ["answered", "budget_exhausted", "cancelled", "failed", "paused", "pending", "running"]},
            "critic": {"enum": ["answered", "budget_exhausted", "cancelled", "failed", "paused", "pending", "running"]},
            "direct": {"enum": ["answered", "budget_exhausted", "cancelled", "failed", "paused", "pending", "running"]},
            "evidence": {"enum": ["answered", "budget_exhausted", "cancelled", "failed", "paused", "pending", "running"]}
          },
