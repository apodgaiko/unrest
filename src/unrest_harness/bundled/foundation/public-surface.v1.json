      "properties": {"action": {"enum": ["continue", "nudge", "stop_for_attention"]}, "actor": {"enum": ["orchestrator", "maintainer", "timeout_policy"]}, "attempt_id": {"type": "string"}, "body_byte_count": {"maximum": 2048, "minimum": 0, "type": "integer"}, "body_sha256": {"type": ["string", "null"]}, "checkpoint_sequence": {"minimum": 0, "type": "integer"}, "code": {"enum": ["continued", "timeout_continue", "nudge_pending", "nudge_delivered", "nudge_consumed", "stop_requested", "delivery_blocked"]}, "delivery_status": {"enum": ["not_applicable", "pending", "delivered", "consumed", "delivery_blocked"]}, "mission_id": {"type": "string"}, "node_id": {"type": ["string", "null"]}, "project_id": {"type": "string"}, "receipt_sequence": {"minimum": 1, "type": "integer"}, "terminal_review_id": {"type": ["string", "null"]}},
