      "required": ["question", "budget", "idempotency_key"],
      "type": "object"
    },
    "project_envelope": {
      "additionalProperties": false,
      "properties": {"active_attempts": {"default": [], "items": {"$ref": "#/definitions/active_attempt_snapshot"}, "type": "array"}, "dag": {"default": null, "type": ["string", "null"]}, "frontier": {"default": null, "type": ["string", "null"]}, "harnessRoot": {"type": "string"}, "next_action": {"enum": ["abort_project", "submit_plan", "advance_project", "decide_attention", "end_mission", "none"]}, "projectId": {"type": "string"}, "projectRoot": {"type": "string"}, "state": {"$ref": "#/definitions/project_state"}, "supersession_lineage": {"default": [], "items": {"$ref": "#/definitions/supersession_lineage_entry"}, "type": "array"}},
      "required": ["projectId", "state", "projectRoot", "harnessRoot", "next_action", "active_attempts", "supersession_lineage"],
