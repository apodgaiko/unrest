                "critic": {"minimum": 0, "type": ["integer", "null"]},
                "direct": {"minimum": 0, "type": ["integer", "null"]},
                "evidence": {"minimum": 0, "type": ["integer", "null"]}
              },
              "type": "object"
            },
            "error_codes": {
              "additionalProperties": false,
              "properties": {
                "analogy": {"enum": ["adapter_not_configured", "adapter_start_failed", "budget_exhausted", "cancelled", "invalid_structured_output", "output_limit_exceeded", "protocol_error", "timed_out", null]},
                "critic": {"enum": ["adapter_not_configured", "adapter_start_failed", "budget_exhausted", "cancelled", "invalid_structured_output", "output_limit_exceeded", "protocol_error", "timed_out", null]},
                "direct": {"enum": ["adapter_not_configured", "adapter_start_failed", "budget_exhausted", "cancelled", "invalid_structured_output", "output_limit_exceeded", "protocol_error", "timed_out", null]},
                "evidence": {"enum": ["adapter_not_configured", "adapter_start_failed", "budget_exhausted", "cancelled", "invalid_structured_output", "output_limit_exceeded", "protocol_error", "timed_out", null]},
                "synthesis": {"enum": ["adapter_not_configured", "adapter_start_failed", "budget_exhausted", "cancelled", "invalid_structured_output", "output_limit_exceeded", "protocol_error", "timed_out", null]}
              },
              "required": ["synthesis"],
              "type": "object"
