        "project_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
        "remaining_target_ids": {"items": {"pattern": "^[A-Z][A-Z0-9-]+$", "type": "string"}, "type": "array", "uniqueItems": true},
        "role": {"enum": ["worker", "validator", "terminal_reviewer"]},
