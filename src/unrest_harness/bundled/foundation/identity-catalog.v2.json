{
  "schema_version": 2,
  "canonicalization": "canonical-json-v1",
  "digest_domain": "unrest.identity-fingerprint.v1",
  "field_definitions": {
    "accepted_working_point_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "artifact_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "base_revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "branch_id": {"pattern": "^branch:[a-z0-9-]+$", "type": "string"},
    "branch_role": {"pattern": "^[a-z][a-z0-9_-]*$", "type": "string"},
    "branch_set_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "budget_envelope": {"additional_properties": false, "properties": {"amount": {"maximum": 9007199254740991, "minimum": -9007199254740991, "type": "integer"}, "unit": {"enum": ["steps"], "type": "string"}}, "required": ["amount", "unit"], "type": "object"},
    "campaign_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "candidate_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "capability_policy_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "consumer_id": {"min_length": 1, "type": "string"},
    "context_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "environment_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "evaluator_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "evidence_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "handoff_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "idempotency_key_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "inquiry_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "operation": {"enum": ["abort_project", "add_candidate", "advance_inquiry", "advance_project", "attach_run", "cancel_inquiry", "cancel_run", "cleanup_workspace", "decide_attention", "end_mission", "evaluate_candidate", "handoff_inquiry", "inspect_campaign", "inspect_inquiry", "inspect_run", "inspect_workspace", "integrate_workspace", "lease_workspace", "open_campaign", "open_inquiry", "pause_inquiry", "promote_candidate", "resume_inquiry", "return_workspace", "review_candidate", "rollback_promotion", "start_project", "submit_plan", "submit_run"], "type": "string"},
    "provider_configuration_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "public_id": {"min_length": 1, "type": "string"},
    "question_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "review_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "route_profile_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "run_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": 1, "type": "integer"},
    "secret_set_version_id": {"pattern": "^secret-set:[a-z0-9-]+:v[1-9][0-9]*$", "type": "string"},
    "seed": {"maximum": 9007199254740991, "minimum": -9007199254740991, "type": "integer"},
    "synthesis_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "workload_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "workspace_lease_id": {"pattern": "^lease:[a-z0-9-]+$", "type": "string"}
  },
  "identity_kinds": [
    {"consumers": ["integration_receipt.v1", "promotion_receipt.v1", "rollback_receipt.v1", "run_identity.v1"], "domain": "accepted_working_point_identity.v1", "id": "accepted_working_point", "required_dimensions": ["accepted_working_point_digest", "base_revision"]},
    {"consumers": ["candidate_identity.v1", "evidence_identity.v1", "receipt_artifact_refs"], "domain": "artifact_identity.v1", "id": "artifact", "required_dimensions": ["artifact_digest"]},
    {"consumers": ["accepted_working_point_identity.v1", "candidate_identity.v1", "run_identity.v1", "workspace_lease_identity.v1"], "domain": "base_identity.v1", "id": "base", "required_dimensions": ["base_revision"]},
    {"consumers": ["run_identity.v1"], "domain": "budget_identity.v1", "id": "budget", "required_dimensions": ["budget_envelope"]},
    {"consumers": ["evaluation_receipt.v1", "integration_receipt.v1", "promotion_receipt.v1", "review_receipt.v1", "run_identity.v1"], "domain": "candidate_identity.v1", "id": "candidate", "required_dimensions": ["accepted_working_point_digest", "artifact_digest", "base_revision", "candidate_digest", "capability_policy_digest", "context_digest", "route_profile_digest"]},
    {"consumers": ["candidate_identity.v1", "evaluator_identity.v1", "run_identity.v1"], "domain": "context_identity.v1", "id": "context", "required_dimensions": ["context_digest"]},
    {"consumers": ["evaluator_identity.v1", "run_identity.v1", "workload_identity.v1"], "domain": "environment_identity.v1", "id": "environment", "required_dimensions": ["environment_digest"]},
    {"consumers": ["evaluation_receipt.v1", "review_identity.v1", "run_identity.v1"], "domain": "evaluator_identity.v1", "id": "evaluator", "required_dimensions": ["environment_digest", "evaluator_digest", "workload_digest"]},
    {"consumers": ["review_identity.v1", "review_receipt.v1"], "domain": "evidence_identity.v1", "id": "evidence", "required_dimensions": ["artifact_digest", "candidate_digest", "evidence_digest", "evaluator_digest"]},
    {"consumers": ["candidate_identity.v1", "run_identity.v1", "workspace_lease_identity.v1"], "domain": "policy_identity.v1", "id": "policy", "required_dimensions": ["capability_policy_digest"]},
    {"consumers": ["route_profile_identity.v1", "run_identity.v1"], "domain": "provider_configuration_identity.v1", "id": "provider_configuration", "required_dimensions": ["provider_configuration_digest", "secret_set_version_id"]},
    {"consumers": ["promotion_receipt.v1", "review_receipt.v1"], "domain": "review_identity.v1", "id": "review", "required_dimensions": ["candidate_digest", "evidence_digest", "review_digest"]},
    {"consumers": ["candidate_identity.v1", "run_identity.v1"], "domain": "route_profile_identity.v1", "id": "route_profile", "required_dimensions": ["provider_configuration_digest", "route_profile_digest"]},
    {"consumers": ["artifact_identity.v1", "run_receipt.v1"], "domain": "run_identity.v1", "id": "run", "required_dimensions": ["accepted_working_point_digest", "base_revision", "budget_envelope", "candidate_digest", "capability_policy_digest", "context_digest", "environment_digest", "evaluator_digest", "provider_configuration_digest", "route_profile_digest", "secret_set_version_id", "seed", "workload_digest", "workspace_lease_id"]},
    {"consumers": ["provider_configuration_identity.v1", "run_identity.v1"], "domain": "secret_set_version_identity.v1", "id": "secret_set_version", "required_dimensions": ["secret_set_version_id"]},
    {"consumers": ["run_identity.v1", "workload_identity.v1"], "domain": "seed_identity.v1", "id": "seed", "required_dimensions": ["seed"]},
    {"consumers": ["evaluation_receipt.v1", "evaluator_identity.v1", "run_identity.v1"], "domain": "workload_identity.v1", "id": "workload", "required_dimensions": ["environment_digest", "seed", "workload_digest"]},
    {"consumers": ["patch_receipt.v1", "run_identity.v1", "workspace_receipt.v1"], "domain": "workspace_lease_identity.v1", "id": "workspace_lease", "required_dimensions": ["base_revision", "capability_policy_digest", "workspace_lease_id"]},
    {"consumers": ["inquiry_branch_identity.v1", "inquiry_synthesis_identity.v1", "inquiry_handoff_identity.v1"], "domain": "inquiry_identity.v1", "id": "inquiry", "required_dimensions": ["question_digest", "capability_policy_digest", "budget_envelope"]},
    {"consumers": ["inquiry_synthesis_identity.v1"], "domain": "inquiry_branch_identity.v1", "id": "inquiry_branch", "required_dimensions": ["inquiry_digest", "branch_id", "branch_role", "budget_envelope", "provider_configuration_digest", "route_profile_digest"]},
    {"consumers": ["inquiry_handoff_identity.v1"], "domain": "inquiry_synthesis_identity.v1", "id": "inquiry_synthesis", "required_dimensions": ["inquiry_digest", "branch_set_digest", "synthesis_digest"]},
    {"consumers": ["evidence_store"], "domain": "inquiry_handoff_identity.v1", "id": "inquiry_handoff", "required_dimensions": ["inquiry_digest", "synthesis_digest", "handoff_digest", "consumer_id"]},
    {"consumers": ["run_receipt.v1", "evidence_store"], "domain": "control_operation_identity.v1", "id": "control_operation", "required_dimensions": ["run_digest", "operation", "idempotency_key_digest"]},
    {"consumers": ["evaluation_receipt.v1", "review_receipt.v1", "promotion_receipt.v1"], "domain": "campaign_identity.v1", "id": "campaign", "required_dimensions": ["accepted_working_point_digest", "campaign_digest", "evaluator_digest", "workload_digest", "budget_envelope"]}
  ]
}
