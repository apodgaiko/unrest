      "revocation_authority": "parent_integration_authority",
      "signature_policy": "required_before_authoritative_consumption",
      "subject_kind": "accepted_working_point",
      "terminal_dispositions": ["integrated", "rejected", "rework", "rolled_back"]
    },
    {
      "consumers": ["evidence_store", "parent_integration_authority"],
      "dependencies": [
        {"dependency_kind": "artifact", "dependency_type": "identity", "must_be_fresh": true, "role": "artifact_digest"},
        {"dependency_kind": "base", "dependency_type": "identity", "must_be_fresh": true, "role": "base_revision"},
        {"dependency_kind": "candidate", "dependency_type": "identity", "must_be_fresh": true, "role": "candidate_digest"},
        {"dependency_kind": "policy", "dependency_type": "identity", "must_be_fresh": true, "role": "capability_policy_digest"},
        {"dependency_kind": "environment", "dependency_type": "identity", "must_be_fresh": true, "role": "environment_digest"},
        {"dependency_kind": "workspace_lease", "dependency_type": "identity", "must_be_fresh": true, "role": "workspace_lease_id"},
        {"dependency_kind": "workspace_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "workspace_receipt_evidence"}
      ],
      "expiry_rule": "dependency_bound",
      "id": "patch_receipt.v1",
      "issuer_authority": "workspace_return_authority",
      "outcomes": ["cancelled_partial_return", "failed_return", "patch_returned", "unsettled_effects"],
      "revocation_authority": "workspace_return_authority",
      "signature_policy": "deferred_optional",
      "subject_kind": "candidate",
      "terminal_dispositions": ["attention", "failed", "returned"]
    },
    {
      "consumers": ["evidence_store", "maintainer", "rollback_authority"],
      "dependencies": [
        {"dependency_kind": "accepted_working_point", "dependency_type": "identity", "must_be_fresh": true, "role": "accepted_working_point_digest"},
        {"dependency_kind": "candidate", "dependency_type": "identity", "must_be_fresh": true, "role": "candidate_digest"},
        {"dependency_kind": "evaluation_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "evaluation_receipt_evidence"},
        {"dependency_kind": "integration_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "integration_receipt_evidence"},
        {"dependency_kind": "review_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "review_receipt_evidence"}
      ],
      "expiry_rule": "dependency_bound",
      "id": "promotion_receipt.v1",
      "issuer_authority": "promotion_authority",
      "outcomes": ["inconclusive", "promoted", "rejected", "rework"],
      "revocation_authority": "promotion_authority",
      "signature_policy": "required_before_authoritative_consumption",
      "subject_kind": "candidate",
      "terminal_dispositions": ["inconclusive", "promoted", "rejected", "rework"]
    },
    {
