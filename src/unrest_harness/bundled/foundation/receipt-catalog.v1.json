        {"dependency_kind": "evaluation_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "evaluation_receipt_evidence"},
        {"dependency_kind": "evaluator", "dependency_type": "identity", "must_be_fresh": true, "role": "evaluator_digest"},
        {"dependency_kind": "evidence", "dependency_type": "identity", "must_be_fresh": true, "role": "evidence_digest"},
        {"dependency_kind": "review", "dependency_type": "identity", "must_be_fresh": true, "role": "review_digest"}
      ],
      "expiry_rule": "dependency_bound",
      "id": "review_receipt.v1",
      "issuer_authority": "independent_review_authority",
      "outcomes": ["approve", "cancelled", "dissent", "inconclusive", "reject", "rework"],
      "revocation_authority": "independent_review_authority",
      "signature_policy": "required_before_authoritative_consumption",
      "subject_kind": "candidate",
      "terminal_dispositions": ["approved", "inconclusive", "rejected", "rework"]
    },
    {
      "consumers": ["evidence_store", "maintainer"],
      "dependencies": [
        {"dependency_kind": "accepted_working_point", "dependency_type": "identity", "must_be_fresh": true, "role": "accepted_working_point_digest"},
        {"dependency_kind": "artifact", "dependency_type": "identity", "must_be_fresh": true, "role": "artifact_digest"},
        {"dependency_kind": "policy", "dependency_type": "identity", "must_be_fresh": true, "role": "capability_policy_digest"},
        {"dependency_kind": "integration_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "integration_receipt_evidence"},
        {"dependency_kind": "promotion_receipt.v1", "dependency_type": "receipt", "must_be_fresh": true, "role": "promotion_receipt_evidence"}
      ],
      "expiry_rule": "dependency_bound",
      "id": "rollback_receipt.v1",
      "issuer_authority": "rollback_authority",
      "outcomes": ["failed_unsettled", "restored_and_validated"],
      "revocation_authority": "rollback_authority",
      "signature_policy": "required_before_authoritative_consumption",
      "subject_kind": "accepted_working_point",
      "terminal_dispositions": ["attention", "restored"]
    },
    {
      "consumers": ["evaluation_authority", "evidence_store", "workspace_authority"],
      "dependencies": [
        {"dependency_kind": "accepted_working_point", "dependency_type": "identity", "must_be_fresh": true, "role": "accepted_working_point_digest"},
        {"dependency_kind": "base", "dependency_type": "identity", "must_be_fresh": true, "role": "base_revision"},
        {"dependency_kind": "budget", "dependency_type": "identity", "must_be_fresh": true, "role": "budget_envelope"},
        {"dependency_kind": "candidate", "dependency_type": "identity", "must_be_fresh": true, "role": "candidate_digest"},
        {"dependency_kind": "policy", "dependency_type": "identity", "must_be_fresh": true, "role": "capability_policy_digest"},
        {"dependency_kind": "context", "dependency_type": "identity", "must_be_fresh": true, "role": "context_digest"},
        {"dependency_kind": "environment", "dependency_type": "identity", "must_be_fresh": true, "role": "environment_digest"},
        {"dependency_kind": "evaluator", "dependency_type": "identity", "must_be_fresh": true, "role": "evaluator_digest"},
        {"dependency_kind": "provider_configuration", "dependency_type": "identity", "must_be_fresh": true, "role": "provider_configuration_digest"},
