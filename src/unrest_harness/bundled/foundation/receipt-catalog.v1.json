        {"dependency_kind": "secret_set_version", "dependency_type": "identity", "must_be_fresh": true, "role": "secret_set_version_id"},
        {"dependency_kind": "seed", "dependency_type": "identity", "must_be_fresh": true, "role": "seed"},
        {"dependency_kind": "workload", "dependency_type": "identity", "must_be_fresh": true, "role": "workload_digest"},
        {"dependency_kind": "workspace_lease", "dependency_type": "identity", "must_be_fresh": true, "role": "workspace_lease_id"}
